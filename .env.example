# ============================================
# App URLs
# ============================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# Authentication (better-auth)
# ============================================
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ============================================
# Database
# ============================================
# Local PostgreSQL
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/mythoria_db"

# Neon Cloud (for Discord sync)
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# เลือกว่าจะต่อฐานไหน: local = LOCAL_DATABASE_URL, ค่าอื่น/ไม่ตั้ง = NEON_DATABASE_URL || DATABASE_URL
# บนโปรดักชันต้องไม่ใช่ local
DB_TARGET=local
LOCAL_DATABASE_URL="postgresql://postgres:your-password@localhost:5432/mythoria_db"

# cache ผลเรียก LLM ของ pythonservice (character_analyzer.py) — ไม่ตั้งก็ทำงานได้ แค่ไม่ cache
# ฝั่ง Next ไม่ได้ใช้ตัวนี้ ต้องไปตั้งที่ host ของ python ไม่ใช่ Vercel
REDIS_URL=redis://localhost:6379

# ============================================
# AI API Keys
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
TYPHOON_API_KEY=your-typhoon-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OLLAMA_API_KEY=your-ollama-api-key-here

# ============================================
# Google OAuth & Drive
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Cloudinary (Image Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ============================================
# Error tracking (Sentry) — เฉพาะ production, ว่างไว้ตอน dev ก็ได้
# ============================================
NEXT_PUBLIC_SENTRY_DSN=

# ============================================
# App Settings
# ============================================
REGISTRATION_CODE=your-registration-code

# ============================================
# Python service (ไม่บังคับ — อยู่คนละ repo คือ Mythoria_bot)
# ถ้าไม่ตั้ง ฟีเจอร์ที่เรียก service นี้จะใช้ไม่ได้ แต่ตัวแอปทำงานปกติ
# ============================================
PYTHON_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=

# บัญชีเดโมสำหรับโหมดผู้เยี่ยมชม (สร้างด้วย npm run seed:demo)
DEMO_EMAIL=demo@mythoria.app
DEMO_PASSWORD=
