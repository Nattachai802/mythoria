# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python spell cache (generated at runtime)

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/pythonservice/discord_bot/

# Python
venv/
.venv/
__pycache__/
*.pyc
.env

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ยกเว้นเทมเพลต — มีแต่ค่าตัวอย่าง ไม่มีความลับ และคนที่ clone ต้องใช้ตั้งค่า
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vector database
/vector-db

# DB dumps — อย่า commit (มี secret)
backup.sql
backup/

# impeccable local cache (เก็บ path ในเครื่อง ไม่ควรแชร์)
.impeccable/hook.cache.json
